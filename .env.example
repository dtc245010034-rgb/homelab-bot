# homelab-bot - cau hinh. Sao chep file nay thanh .env (hoac chay `npm run setup` de duoc hoi tung buoc).
# KHONG BAO GIO commit file .env that.
# Doi .env xong phai khoi dong lai bot:  pm2 restart homelab-bot   (hoac chay lai `npm start`)
#
# Quy uoc: dong KHONG co dau # la gia tri ban nen dien. Dong bat dau bang "#KEY=gia_tri" la tuy chon,
# gia tri ghi san la MAC DINH - bo dau # va sua neu muon doi. Bo trong/xoa dong = dung mac dinh.
# Gia tri khong hop le (chu thay vi so, ngoai khoang cho phep...) cung tu dong ve mac dinh, bot khong bi chet.

# ── Bat buoc ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # lay tu @BotFather
ALLOWED_CHAT_ID=            # so chat id cua ban (nhan tin cho bot roi chay `npm run setup`, hoac hoi @userinfobot)

# ── Agent AI (tuy chon, khuyen dung) ─────────────────────
GEMINI_API_KEY=             # https://aistudio.google.com/apikey (goi mien phi du dung ca nhan)
GEMINI_MODEL=gemini-3.6-flash

# ── Thoi tiet / ban do mua / ban tin sang (tuy chon) ─────
OWM_API_KEY=                # https://openweathermap.org/api (goi mien phi)
LOCATION_NAME=Hà Nội        # ten khu vuc hien thi
LOCATION_LAT=21.0278
LOCATION_LON=105.8342

# ── May chu ──────────────────────────────────────────────
HOST_NAME=                  # ten hien thi cua may chu; bo trong = hostname that

# ── May tinh chinh: /ping va /wol (tuy chon) ─────────────
MAIN_PC_IP=                 # vd 192.168.1.62
MAIN_PC_MAC=                # vd AA:BB:CC:DD:EE:FF (Wake-on-LAN)
WOL_BROADCAST=              # bo trong = tu suy ra x.x.x.255 tu MAIN_PC_IP

# ── Quet mang /netscan: dat ten cho thiet bi (tuy chon) ──
KNOWN_DEVICES=              # vd 192.168.1.1=Router;192.168.1.5=NAS

# ── Camera Hikvision: /cam va canh bao chuyen dong (tuy chon) ──
CAM_RTSP_URL=               # vd rtsp://USER:PASS@192.168.1.X:554/Streaming/Channels/101
CAM_MOTION_RTSP_URL=        # bo trong = tu suy ra kenh 102 (sub-stream) tu CAM_RTSP_URL

# ── Pi-hole (tuy chon) ───────────────────────────────────
PIHOLE_PASSWORD=            # mat khau web cua Pi-hole; bo trong = doc tu file .pihole-secret (mot dong, chmod 600)

# ═══ TUY BIEN NANG CAO (tat ca deu tuy chon, gia tri ghi san la mac dinh) ═══════════════════

# ── Mui gio & ngon ngu hien thi ──────────────────────────
# Lich hen gio, bao cao sang, thoi gian trong tin nhan deu theo mui gio nay (ten IANA).
#TIMEZONE=Asia/Ho_Chi_Minh   # vd Asia/Bangkok, Europe/Paris, America/New_York
#LOCALE=vi-VN                # dinh dang ngay/so: vi-VN, en-US, fr-FR...

# ── Canh bao tai nguyen (CPU/RAM/o cung/nhiet do) ────────
#ALERTS_ENABLED=1            # 0 = tat han canh bao tu dong
#ALERT_CPU_PCT=85            # canh bao khi CPU vuot % nay
#ALERT_RAM_PCT=85
#ALERT_DISK_PCT=85
#ALERT_TEMP_C=78             # nhiet do CPU (do C)
#ALERT_COOLDOWN_MIN=30       # moi loai canh bao toi da 1 lan / so phut nay
#ALERT_CHECK_INTERVAL_MIN=5  # bao lau kiem tra mot lan
#DISK_MOUNT=/                # diem gan o cung can theo doi (vd /mnt/data)
#STATUS_WARN_PCT=75          # /status: tu % nay hien [CANH BAO]
#STATUS_CRIT_PCT=85          # /status: tu % nay hien [NGUY HIEM]

# ── Pi-hole ──────────────────────────────────────────────
#PIHOLE_URL=http://localhost # dia chi Pi-hole, vd http://192.168.1.2:8080

# ── Gio chay cac tac vu he thong ─────────────────────────
# Dinh dang "HH:MM" hoac "thu HH:MM" (mon tue wed thu fri sat sun, hoac t2..t7 cn). "off" = tat.
#SCHEDULE_DAILY_DIGEST=06:30         # tom tat lich trong ngay
#SCHEDULE_WEEKEND_REMINDER=sat 07:30 # nhac len ke hoach cuoi tuan
#SCHEDULE_WEEKLY_REPORT=mon 08:00    # bao cao tuan

# ── Ban tin sang (morning.js, chay bang cron) ────────────
#MORNING_SECTIONS=stocks,weather,news,map   # bo muc nao thi xoa muc do khoi danh sach
#MORNING_SYMBOLS=E1VFVN30.VN                # ma chung khoan/ETF theo Yahoo Finance, ngan cach bang dau phay
#MORNING_MAP_PRESET=vn       # vn = ca nuoc + Bien Dong, tn = khu vuc cua ban (LOCATION_*)
#MORNING_MAP_LAYER=rain      # rain | clouds | wind | temp

# ── Nguon tin RSS (thay hoan toan danh sach mac dinh) ────
# Dinh dang: Ten|url|so_tin toi da moi nguon, ngan cach bang dau ;
#NEWS_FEEDS=VnExpress|https://vnexpress.net/rss/tin-moi-nhat.rss|3;Hacker News|https://news.ycombinator.com/rss|2
#AI_NEWS_FEEDS=TechCrunch AI|https://techcrunch.com/category/artificial-intelligence/feed/|5

# ── Canh bao chuyen dong camera (motion-check.js) ────────
#MOTION_THRESHOLD=6000       # do nhay: so cang nho cang nhay (RMSE giua 2 khung hinh)
#MOTION_COOLDOWN_MIN=5       # sau mot canh bao, nghi bao nhieu phut
#MOTION_INTERVAL_SEC=60      # bao lau chup so sanh mot lan
#MOTION_CLIP_SECONDS=10      # do dai clip gui kem canh bao
#MOTION_FAIL_THRESHOLD=3     # camera loi lien tiep may lan thi bao "mat ket noi"
#MOTION_CLIP_TRANSCODE=1     # 1 = clip ma hoa H.264 (phat duoc tren Telegram); 0 = copy nguyen luong

# ── Agent AI: model ──────────────────────────────────────
# Chuoi xoay ca: GEMINI_MODEL truoc, het quota thi sang lan luot cac model nay (ngan cach bang dau phay).
#GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
#AGENT_DAILY_LIMIT_DISPLAY=20  # han muc/ngay hien thi trong /agent quota cho model chua tung bi 429 (chi de hien thi)

# ── Agent AI: gioi han an toan & hieu nang ───────────────
#AGENT_MAX_TOOL_LOOPS=8          # so luot goi cong cu toi da cho moi cau hoi
#AGENT_MAX_UNATTENDED_LOOPS=12   # nhu tren, cho tac vu hen gio (khong co nguoi xem)
#AGENT_UNATTENDED_TIMEOUT_MIN=5  # tac vu hen gio chay qua so phut nay thi bo
#AGENT_REQUEST_TIMEOUT_SEC=90    # cho Gemini tra loi toi da bao lau
#AGENT_CONFIRM_TIMEOUT_SEC=120   # thoi gian cho bam Dong y/Huy khi agent xin xac nhan
#AGENT_SESSION_IDLE_HOURS=48     # nghi qua so gio nay thi cat phien tro chuyen moi
#AGENT_HISTORY_TURNS=15          # so luot hoi-dap gan nhat gui kem moi lan goi (nhieu = ton quota va token hon)
#AGENT_KEEP_REPORTS=30           # so file bao cao Word giu lai trong agent-workspace/reports

# ── Ban do thoi tiet /wmap ───────────────────────────────
#WMAP_WATERMARK=homelab-bot  # chu in goc anh
#WMAP_LOCAL_ZOOM=9           # do zoom ban do khu vuc (3 xa .. 12 gan)
#WMAP_LOCAL_RADIUS=1         # so o ban do mo rong quanh vi tri (1 = 3x3)

# ── Telegram ─────────────────────────────────────────────
#TELEGRAM_API_BASE=https://api.telegram.org  # doi neu dung proxy hoac may chu Bot API cuc bo
