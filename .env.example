# homelab-bot - cau hinh. Sao chep file nay thanh .env (hoac chay `npm run setup` de duoc hoi tung buoc).
# KHONG BAO GIO commit file .env that.

# ── Bat buoc ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # lay tu @BotFather
ALLOWED_CHAT_ID=            # so chat id cua ban (nhan tin cho bot roi chay `npm run setup`, hoac hoi @userinfobot)

# ── Agent AI (tuy chon, khuyen dung) ─────────────────────
GEMINI_API_KEY=             # https://aistudio.google.com/apikey (goi mien phi du dung ca nhan)
GEMINI_MODEL=gemini-3.6-flash

# ── Thoi tiet / ban do mua / ban tin sang (tuy chon) ─────
OWM_API_KEY=                # https://openweathermap.org/api (goi mien phi)
LOCATION_NAME=Hà Nội        # ten khu vuc hien thi
LOCATION_LAT=21.0278
LOCATION_LON=105.8342

# ── May chu ──────────────────────────────────────────────
HOST_NAME=                  # ten hien thi cua may chu; bo trong = hostname that

# ── May tinh chinh: /ping va /wol (tuy chon) ─────────────
MAIN_PC_IP=                 # vd 192.168.1.62
MAIN_PC_MAC=                # vd AA:BB:CC:DD:EE:FF (Wake-on-LAN)
WOL_BROADCAST=              # bo trong = tu suy ra x.x.x.255 tu MAIN_PC_IP

# ── Quet mang /netscan: dat ten cho thiet bi (tuy chon) ──
KNOWN_DEVICES=              # vd 192.168.1.1=Router;192.168.1.5=NAS

# ── Camera Hikvision: /cam va canh bao chuyen dong (tuy chon) ──
CAM_RTSP_URL=               # vd rtsp://USER:PASS@192.168.1.X:554/Streaming/Channels/101
CAM_MOTION_RTSP_URL=        # bo trong = tu suy ra kenh 102 (sub-stream) tu CAM_RTSP_URL
MOTION_CLIP_TRANSCODE=1     # 1 = clip canh bao ma hoa H.264 (phat duoc tren Telegram); 0 = copy nguyen luong
